<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <!-- a consent source for CommerceKings_Consent: reads a vanilla-cookieconsent cookie. No dependency on any banner module. -->
    <module name="CommerceKings_ConsentVanilla">
        <sequence>
            <module name="CommerceKings_Consent"/>
            <module name="CommerceKings_ConsentDefaults"/>
        </sequence>
    </module>
</config>
