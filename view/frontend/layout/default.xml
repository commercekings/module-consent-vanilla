<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="CommerceKings_ConsentVanilla::css/lib/cookieconsent.css"/>
    </head>
    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="commercekings.consent.banner"
                   template="CommerceKings_ConsentVanilla::banner.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">CommerceKings\ConsentVanilla\ViewModel\Banner</argument>
                </arguments>
            </block>
        </referenceContainer>
        <!-- "Cookie settings" in the footer links (themes without footer_links: put an element with
             class ck-cookie-settings anywhere instead, and remove this block) -->
        <referenceBlock name="footer_links">
            <block class="Magento\Framework\View\Element\Template" name="commercekings.consent.footer.link"
                   template="CommerceKings_ConsentVanilla::footer-link.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">CommerceKings\ConsentVanilla\ViewModel\Banner</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
