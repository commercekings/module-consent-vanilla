{
    "name": "commercekings/module-consent-vanilla",
    "description": "vanilla-cookieconsent (orestbida/cookieconsent v3) as a consent source for commercekings/module-consent.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0",
        "magento/module-config": "^101.2",
        "commercekings/module-consent": "^0.1",
        "commercekings/module-consent-defaults": "^0.1"
    },
    "provide": {
        "commercekings/consent-source": "0.1.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\ConsentVanilla\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-consent-vanilla",
    "support": {
        "issues": "https://github.com/commercekings/module-consent-vanilla/issues",
        "source": "https://github.com/commercekings/module-consent-vanilla"
    }
}
